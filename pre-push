#!/bin/bash
# Pre-push hook: verify build before pushing
# Blocks pushes to main on origin to encourage PR workflow.

remote="$1"
url="$2"

# Only check pushes to origin (not other remotes)
if [[ "$remote" != "origin" ]]; then
    exit 0
fi

# Read the refs being pushed
z40=0000000000000000000000000000000000000000
while read local_ref local_sha remote_ref remote_sha
do
    # Skip branch deletion
    if [[ "$local_sha" == "$z40" ]]; then
        continue
    fi

    # Block direct pushes to main on origin
    if [[ "$remote_ref" == "refs/heads/main" ]]; then
        echo "❌ Direct push to main is not allowed."
        echo "   Create a pull request instead:"
        echo "     git checkout -b feature/your-feature"
        echo "     git push origin feature/your-feature"
        echo "     → Open PR on GitHub from your feature branch to main."
        exit 1
    fi

    # Verify build for feature/fix branches
    if [[ "$remote_ref" =~ ^refs/heads/(feature|fix)/ ]]; then
        echo "🔨 Building before push..."
        cd "$(git rev-parse --show-toplevel)/src/VereinMember" || cd "$(git rev-parse --show-toplevel)"
<<<<<<< HEAD
            echo "❌ Build failed. Fix errors before pushing."
            exit 1
        fi
        echo "✅ Build OK."
    fi
done

exit 0