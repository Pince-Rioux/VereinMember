@page "/Membership/Profile"
@model VereinMember.Areas.Membership.Pages.ProfileModel
@{
    ViewData["Title"] = "Mein Profil";
}

<partial name="_MembershipNavPartial" />

<h1>Mein Profil</h1>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (Model.Member == null)
{
    <div class="alert alert-warning">Mitglied nicht gefunden.</div>
    return;
}

<form method="post" class="row g-3">
    <div asp-validation-summary="ModelOnly" class="text-danger col-12"></div>
    <input type="hidden" asp-for="Input.Id" />
    <input type="hidden" asp-for="Input.ConcurrencyToken" />

    <div class="col-12">
        <h5 class="border-bottom pb-2">Persönliche Daten</h5>
    </div>

    <div class="col-md-6">
        <label asp-for="Input.FirstName" class="form-label">Vorname</label>
        <input asp-for="Input.FirstName" class="form-control" />
        <span asp-validation-for="Input.FirstName" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Input.LastName" class="form-label">Nachname</label>
        <input asp-for="Input.LastName" class="form-control" />
        <span asp-validation-for="Input.LastName" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label class="form-label">E-Mail</label>
        <input value="@Model.Member.Email" class="form-control" readonly disabled />
        <small class="text-muted">Die E-Mail-Adresse kann nicht geändert werden.</small>
    </div>
    <div class="col-md-6">
        <label asp-for="Input.Phone" class="form-label">Telefon</label>
        <input asp-for="Input.Phone" class="form-control" />
        <span asp-validation-for="Input.Phone" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label class="form-label">Geburtsdatum</label>
        <div class="form-control bg-light" style="cursor:not-allowed">
            @(Model.Member.BirthDate.Year > 1 ? Model.Member.BirthDate.ToString("dd.MM.yyyy") : "-")
        </div>
        <small class="text-muted">Das Geburtsdatum kann nicht geändert werden.</small>
    </div>
    <div class="col-md-4">
        <label class="form-label">Beitragsgruppe</label>
        <input class="form-control" value="@(Model.Member.MembershipFee?.Name ?? "-")" readonly disabled />
    </div>
    <div class="col-md-4">
        <label class="form-label">Status</label>
        <input class="form-control" value="@Model.Member.Status" readonly disabled />
    </div>

    <div class="col-12 mt-3">
        <h5 class="border-bottom pb-2">Adresse</h5>
    </div>

    <div class="col-md-6">
        <label asp-for="Input.Street" class="form-label">Straße</label>
        <input asp-for="Input.Street" class="form-control" />
        <span asp-validation-for="Input.Street" class="text-danger"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="Input.ZipCode" class="form-label">PLZ</label>
        <input asp-for="Input.ZipCode" class="form-control" />
        <span asp-validation-for="Input.ZipCode" class="text-danger"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="Input.City" class="form-label">Ort</label>
        <input asp-for="Input.City" class="form-control" />
        <span asp-validation-for="Input.City" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Input.Country" class="form-label">Land</label>
        <input asp-for="Input.Country" class="form-control" />
        <span asp-validation-for="Input.Country" class="text-danger"></span>
    </div>

    @if (Model.Member.FamilyGroup != null)
    {
        <div class="col-12 mt-3">
            <h5 class="border-bottom pb-2">Familie</h5>
        </div>
        <div class="col-12">
            <label class="form-label">Familie</label>
            <input class="form-control" value="@(Model.Member.FamilyGroup.Name ?? "Familie #" + Model.Member.FamilyGroup.Id)" readonly disabled />
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.GuardianDisplayName) ||
        !string.IsNullOrWhiteSpace(Model.GuardianEmail) ||
        !string.IsNullOrWhiteSpace(Model.GuardianPhone))
    {
        <div class="col-12 mt-3">
            <h5 class="border-bottom pb-2">Erziehungsberechtigter</h5>
        </div>
        <div class="col-12">
            <dl class="mb-0">
                @if (!string.IsNullOrWhiteSpace(Model.GuardianDisplayName))
                {
                    <dt>Name</dt>
                    <dd>@Model.GuardianDisplayName</dd>
                }
                @if (!string.IsNullOrWhiteSpace(Model.GuardianEmail))
                {
                    <dt>E-Mail</dt>
                    <dd>@Model.GuardianEmail</dd>
                }
                @if (!string.IsNullOrWhiteSpace(Model.GuardianPhone))
                {
                    <dt>Telefon</dt>
                    <dd>@Model.GuardianPhone</dd>
                }
            </dl>
        </div>
    }

    <div class="col-12 mt-3">
        <h5 class="border-bottom pb-2">Sonstiges</h5>
    </div>
    <div class="col-12">
        <label asp-for="Input.Notes" class="form-label">Notizen</label>
        <textarea asp-for="Input.Notes" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Input.Notes" class="text-danger"></span>
    </div>

    @if (Model.Member.Department != null)
    {
        <div class="col-md-6">
            <label class="form-label">Abteilung</label>
            <input class="form-control" value="@Model.Member.Department.Name" readonly disabled />
        </div>
    }
    <div class="col-md-6">
        <label class="form-label">Eintrittsdatum</label>
        <input class="form-control" value="@Model.Member.JoinedAt.ToShortDateString()" readonly disabled />
    </div>

    <div class="col-12 mt-4">
        <button type="submit" class="btn btn-primary">Speichern</button>
        <a href="/Membership/Logout" class="btn btn-outline-secondary">Abmelden</a>
    </div>
</form>

<div class="mt-3">
    <a href="/" class="btn btn-outline-secondary btn-sm">Zurück zur Startseite</a>
</div>

@section script {
    <partial name="_ValidationScriptsPartial" />
}
