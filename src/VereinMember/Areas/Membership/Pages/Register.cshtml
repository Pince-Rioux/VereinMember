@page "/Membership/Register"
@model VereinMember.Areas.Membership.Pages.RegisterModel
@{
    ViewData["Title"] = "Mitglied werden";
}

<h1>Mitglied werden</h1>
<p class="text-muted">Registrieren Sie sich als Mitglied des Volleyballclub Neusäß e. V. Sie erhalten anschließend eine E-Mail mit einem Link zur Bestätigung und Passwort-Vergabe.</p>

<form method="post" class="row g-3">
    @if (!ModelState.IsValid)
    {
        <div class="alert alert-danger" role="alert">
            <strong>Bitte prüfen Sie Ihre Eingaben:</strong>
            <ul class="mb-0">
                @foreach (var error in ModelState.Values
                    .SelectMany(entry => entry.Errors)
                    .Select(entry => entry.ErrorMessage)
                    .Where(message => !string.IsNullOrWhiteSpace(message))
                    .Distinct())
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    }

    <div class="col-12">
        <h5 class="border-bottom pb-2">Persönliche Daten</h5>
    </div>

    <div class="col-md-6">
        <label asp-for="Input.FirstName" class="form-label"></label>
        <input asp-for="Input.FirstName" class="form-control" />
        <span asp-validation-for="Input.FirstName" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Input.LastName" class="form-label"></label>
        <input asp-for="Input.LastName" class="form-control" />
        <span asp-validation-for="Input.LastName" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Input.Email" class="form-label"></label>
        <input asp-for="Input.Email" class="form-control" type="email" />
        <span asp-validation-for="Input.Email" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Input.Phone" class="form-label"></label>
        <input asp-for="Input.Phone" class="form-control" type="tel" />
        <span asp-validation-for="Input.Phone" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label class="form-label">Geburtsdatum</label>
        <partial name="_DateSelects" model='new DateSelectsViewModel("Input.Birth", Model.Input.BirthDay, Model.Input.BirthMonth, Model.Input.BirthYear, "form-select", "Input_Birth")' />
        <span asp-validation-for="Input.BirthDate" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Input.MembershipFeeId" class="form-label">Beitragsgruppe</label>
        <select asp-for="Input.MembershipFeeId" asp-items="Model.FeeOptions" class="form-select">
            <option value="">Bitte wählen…</option>
        </select>
        <span asp-validation-for="Input.MembershipFeeId" class="text-danger"></span>
    </div>

    @* Guardian section (shown when Youth is selected) *@
    <partial name="_GuardianFields" model='new GuardianFieldsViewModel(
        ShowMemberSelector: false,
        GuardianMemberId: null,
        GuardianOptions: null,
        GuardianFirstName: Model.Input.GuardianFirstName,
        GuardianLastName: Model.Input.GuardianLastName,
        GuardianEmail: Model.Input.GuardianEmail,
        GuardianPhone: Model.Input.GuardianPhone,
        FieldPrefix: "Input.",
        InitiallyHidden: true,
        KeepVisibleIfPopulated: false,
        HeadingText: "Erziehungsberechtigter",
        HeadingClass: "border-bottom pb-2",
        IntroText: "Da Sie unter 18 Jahren sind, benötigen wir die Daten eines Erziehungsberechtigten.")' />

    @* Family section (shown when Family is selected) *@
    @{
        var existingFamilyRows = new List<object>();
        for (int i = 0; i < Model.FamilyMembers.Count; i++)
        {
            var fm = Model.FamilyMembers[i];
            var prefix = $"FamilyMembers[{i}].";
            var rowErrors = ViewData.ModelState
                .Where(kvp => kvp.Key.StartsWith(prefix, StringComparison.Ordinal) && kvp.Value?.Errors.Count > 0)
                .SelectMany(kvp => kvp.Value!.Errors.Select(e => e.ErrorMessage))
                .ToList();
            existingFamilyRows.Add(new
            {
                firstName = fm.FirstName,
                lastName = fm.LastName,
                email = fm.Email,
                birthDay = fm.BirthDay,
                birthMonth = fm.BirthMonth,
                birthYear = fm.BirthYear,
                errors = rowErrors
            });
        }
        var initialFamilyRowsJson = System.Text.Json.JsonSerializer.Serialize(existingFamilyRows);
    }
    <partial name="_FamilyMembersEditor" model='new FamilyMembersEditorViewModel(
        ShowJoinedAt: false,
        IntroText: "Fügen Sie weitere Familienmitglieder hinzu. Sie sind als Hauptmitglied automatisch Teil dieser Familie.",
        InitialRowsJson: initialFamilyRowsJson,
        ShowHrBefore: false)' />

    <partial name="_AddressFields" model='new AddressFieldsViewModel(
        Model.Input.Street,
        Model.Input.ZipCode,
        Model.Input.City,
        Model.Input.Country,
        FieldPrefix: "Input.",
        ShowHeading: true)' />

    @* Zahlungsinformationen *@
    <div class="col-12 mt-3">
        <h5 class="border-bottom pb-2">Zahlungsinformationen</h5>
    </div>
    <div class="col-md-6">
        <label asp-for="Input.BankIban" class="form-label">IBAN</label>
        <input asp-for="Input.BankIban" class="form-control" placeholder="DE00 0000 0000 0000 0000 00" required />
        <span asp-validation-for="Input.BankIban" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Input.BankBic" class="form-label">BIC</label>
        <input asp-for="Input.BankBic" class="form-control" />
        <div class="form-text">Für deutsche IBANs nicht erforderlich.</div>
        <span asp-validation-for="Input.BankBic" class="text-danger"></span>
    </div>

    @* Keep the displayed legal texts in sync with the text versions in RegisterModel. *@
    <div class="col-12 mt-3">
        <h5 class="border-bottom pb-2">Einwilligung und Mitgliedschaft</h5>
        <p class="text-muted">
            Bei Minderjährigen müssen die Erklärungen von einer erziehungsberechtigten Person abgegeben werden.
            Bitte lesen Sie auch unsere <a href="/datenschutz" target="_blank" rel="noopener">Datenschutzerklärung</a>.
        </p>
        <div class="form-check">
            <input asp-for="Input.PrivacyConsented" class="form-check-input" required />
            <label class="form-check-label" asp-for="Input.PrivacyConsented">
                Ich bin widerruflich damit einverstanden, dass alle von mir angegebenen persönlichen und sachlichen
                Daten vom VC Neusäß elektronisch erhoben, verarbeitet, genutzt und an Mitglieder des Vereins
                weitergegeben werden dürfen.
                Die Mitgliedschaft beginnt mit der Annahme des Antrags durch den Vorstand. Sie kann zum Ende eines
                Kalenderjahres beendet werden und ist dem Verein schriftlich unter Einhaltung einer Frist von 4 Wochen
                mitzuteilen. Der Mitgliedsbeitrag ist bis zum 31.01. des laufenden Jahres oder bei Eintritt nach diesem
                Datum sofort mittels SEPA-Lastschriftmandat zu entrichten.
            </label>
            <span asp-validation-for="Input.PrivacyConsented" class="text-danger d-block"></span>
        </div>
    </div>

    <div class="col-12 mt-3">
        <h5 class="border-bottom pb-2">SEPA-Lastschriftmandat</h5>
        <div class="form-check">
            <input asp-for="Input.SepaMandateConsented" class="form-check-input" required />
            <label class="form-check-label" asp-for="Input.SepaMandateConsented">
                Hiermit ermächtige ich den VC Neusäß e.V. widerruflich, den satzungsmäßigen
                Mitgliedsbeitrag wiederkehrend zu Lasten meines nachstehenden Kontos mittels
                Lastschrift einzuziehen. Zugleich weise ich mein Kreditinstitut an, die auf mein Konto
                gezogenen Lastschriften einzulösen.
            </label>
            <span asp-validation-for="Input.SepaMandateConsented" class="text-danger d-block"></span>
        </div>
        <p class="mt-2 mb-0">
            <strong>Hinweis:</strong><br />
            Ich kann innerhalb von acht Wochen, beginnend mit dem Belastungsdatum, die
            Erstattung des belasteten Betrags verlangen. Es gelten dabei die mit meinem
            Kreditinstitut vereinbarten Bedingungen.
        </p>
    </div>

    <div class="col-12 mt-4">
        <button type="submit" class="btn btn-primary btn-lg">Registrieren</button>
        <a href="/" class="btn btn-outline-secondary btn-lg">Abbrechen</a>
    </div>
</form>

@section script {
    <script src="~/_content/VereinMember/js/membership-forms.js" asp-append-version="true"></script>
}