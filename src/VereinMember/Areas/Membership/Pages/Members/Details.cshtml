@page "{id:int}"
@model VereinMember.Areas.Membership.Pages.Members.DetailsModel
@{
    ViewData["Title"] = "Mitglied-Details";
}

<partial name="_MembershipNavPartial" />

<h1>Mitglied-Details</h1>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<dl class="row">
    <dt class="col-sm-3">Name</dt>
    <dd class="col-sm-9">@Model.Member?.LastName, @Model.Member?.FirstName</dd>

    <dt class="col-sm-3">E-Mail</dt>
    <dd class="col-sm-9">@Model.Member?.Email</dd>

    <dt class="col-sm-3">Telefon</dt>
    <dd class="col-sm-9">@(Model.Member?.Phone ?? "-")</dd>

    <dt class="col-sm-3">Geburtsdatum</dt>
    <dd class="col-sm-9">@Model.Member?.BirthDate.ToShortDateString()</dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@(Model.Member != null ? MembershipDisplay.GetGermanStatus(Model.Member.Status) : "-")</dd>

    <dt class="col-sm-3">Abteilung</dt>
    <dd class="col-sm-9">@(Model.Member?.Department?.Name ?? "-")</dd>

    <dt class="col-sm-3">Beitragsgruppe</dt>
    <dd class="col-sm-9">@(Model.Member?.MembershipFee != null ? $"{Model.Member.MembershipFee.Name} ({MembershipDisplay.GetGermanFeeCategory(Model.Member.MembershipFee.Category)})" : "-")</dd>

    @if (Model.Member?.GuardianMember != null)
    {
        <dt class="col-sm-3">Erziehungsberechtigter</dt>
        <dd class="col-sm-9">@Model.Member.GuardianMember.LastName, @Model.Member.GuardianMember.FirstName</dd>
    }
    else if (!string.IsNullOrWhiteSpace(Model.Member?.GuardianFirstName) || !string.IsNullOrWhiteSpace(Model.Member?.GuardianLastName))
    {
        <dt class="col-sm-3">Erziehungsberechtigter</dt>
        <dd class="col-sm-9">
            @($"{Model.Member?.GuardianFirstName} {Model.Member?.GuardianLastName}".Trim())
            @if (!string.IsNullOrWhiteSpace(Model.Member?.GuardianEmail))
            {
                <span class="text-muted">(@Model.Member.GuardianEmail@(string.IsNullOrWhiteSpace(Model.Member.GuardianPhone) ? "" : $", {Model.Member.GuardianPhone}"))</span>
            }
        </dd>
    }

    @if (Model.Member?.FamilyGroup != null)
    {
        <dt class="col-sm-3">Familie</dt>
        <dd class="col-sm-9">@MembershipDisplay.FormatFamilyGroupLabel(Model.Member.FamilyGroup)</dd>
    }

    <dt class="col-sm-3">Adresse</dt>
    <dd class="col-sm-9">@Model.Member?.Street, @Model.Member?.ZipCode @Model.Member?.City, @Model.Member?.Country</dd>

    <dt class="col-sm-3">Beigetreten am</dt>
    <dd class="col-sm-9">@Model.Member?.JoinedAt.ToShortDateString()</dd>

    @if (Model.Member?.LeftAt.HasValue == true)
    {
        <dt class="col-sm-3">Ausgetreten am</dt>
        <dd class="col-sm-9">@Model.Member?.LeftAt.Value.ToShortDateString()</dd>
    }

    <dt class="col-sm-3">Notizen</dt>
    <dd class="col-sm-9">@(Model.Member?.Notes ?? "-")</dd>

    <dt class="col-sm-3">Erstellt</dt>
    <dd class="col-sm-9">@Model.Member?.CreatedAt.ToShortDateString() von @Model.Member?.CreatedBy</dd>

    <dt class="col-sm-3">Aktualisiert</dt>
    <dd class="col-sm-9">@Model.Member?.UpdatedAt.ToShortDateString()</dd>
</dl>

<div class="d-flex flex-wrap gap-2">
    <a asp-page="Edit" asp-route-id="@Model.Member?.Id" class="btn btn-warning">Bearbeiten</a>
    <a asp-page="Index" class="btn btn-secondary">Zurück zur Liste</a>

    @if ((User.IsInRole("Admin") || User.IsInRole("Editor")) && Model.Member != null)
    {
        <form method="post" asp-page-handler="Export" asp-route-id="@Model.Member.Id" class="d-inline">
            <button type="submit" class="btn btn-outline-primary">Datenexport (JSON)</button>
        </form>
    }

    @if (User.IsInRole("Admin") && Model.Member != null && Model.Member.FirstName != "[erased]")
    {
        <form method="post" asp-page-handler="Erasure" asp-route-id="@Model.Member.Id" class="d-inline"
              onsubmit="return confirm('Personenbezogene Daten dieses Mitglieds gemäß DSGVO unwiderruflich löschen?');">
            <button type="submit" class="btn btn-outline-danger">DSGVO-Löschung</button>
        </form>
    }
</div>