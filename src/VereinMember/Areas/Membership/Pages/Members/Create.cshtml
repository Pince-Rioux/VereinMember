@page
@model VereinMember.Areas.Membership.Pages.Members.CreateModel
@{
    ViewData["Title"] = "Mitglied anlegen";
}

<partial name="_MembershipNavPartial" />

<h1>Mitglied anlegen</h1>

<form method="post" class="row g-3">
    @* Main member fields *@
    <div class="col-md-6">
        <label asp-for="Member.FirstName" class="form-label"></label>
        <input asp-for="Member.FirstName" class="form-control" />
        <span asp-validation-for="Member.FirstName" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Member.LastName" class="form-label"></label>
        <input asp-for="Member.LastName" class="form-control" />
        <span asp-validation-for="Member.LastName" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Member.Email" class="form-label"></label>
        <input asp-for="Member.Email" class="form-control" />
        <span asp-validation-for="Member.Email" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Member.Phone" class="form-label"></label>
        <input asp-for="Member.Phone" class="form-control" />
        <span asp-validation-for="Member.Phone" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label class="form-label">Geburtsdatum</label>
        <partial name="_DateSelects" model='new DateSelectsViewModel("Birth", Model.BirthDay, Model.BirthMonth, Model.BirthYear, "form-select", "Birth")' />
        <span asp-validation-for="Member.BirthDate" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Member.MembershipFeeId" class="form-label"></label>
        <select asp-for="Member.MembershipFeeId" asp-items="Model.FeeOptions" class="form-select">
            <option value="">Bitte wählen...</option>
        </select>
        <span asp-validation-for="Member.MembershipFeeId" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Member.DepartmentId" class="form-label"></label>
        <select asp-for="Member.DepartmentId" asp-items="Model.DepartmentOptions" class="form-select">
            <option value="">Keine Abteilung</option>
        </select>
    </div>

    @* Guardian (only for Youth) *@
    <partial name="_GuardianFields" model='new GuardianFieldsViewModel(
        ShowMemberSelector: true,
        GuardianMemberId: Model.Member.GuardianMemberId,
        GuardianOptions: Model.GuardianOptions,
        GuardianFirstName: Model.Member.GuardianFirstName,
        GuardianLastName: Model.Member.GuardianLastName,
        GuardianEmail: Model.Member.GuardianEmail,
        GuardianPhone: Model.Member.GuardianPhone,
        FieldPrefix: "Member.",
        InitiallyHidden: true,
        KeepVisibleIfPopulated: false,
        HeadingText: "Erziehungsberechtigter",
        HeadingClass: "border-bottom pb-2 mt-2")' />

    @* Family members section (only for Family) *@
    @{
        var validationErrors = ViewData.ModelState
            .Where(kvp => kvp.Key.StartsWith("FamilyMembers[") && kvp.Value?.Errors.Count > 0)
            .ToList();
        var memberIndicesWithErrors = validationErrors
            .Select(kvp => {
                var match = System.Text.RegularExpressions.Regex.Match(kvp.Key, @"FamilyMembers\[(\d+)\]");
                return match.Success ? int.Parse(match.Groups[1].Value) : -1;
            })
            .Where(i => i >= 0)
            .Distinct()
            .ToHashSet();
        var initialAdminFamilyRows = new List<object>();
        for (int i = 0; i < Model.FamilyMembers.Count; i++)
        {
            var fm = Model.FamilyMembers[i];
            var hasErrors = memberIndicesWithErrors.Contains(i);
            var errors = validationErrors
                .Where(kvp => kvp.Key.StartsWith($"FamilyMembers[{i}]"))
                .SelectMany(kvp => kvp.Value!.Errors.Select(e => e.ErrorMessage))
                .ToList();
            initialAdminFamilyRows.Add(new
            {
                firstName = fm.FirstName,
                lastName = fm.LastName,
                email = fm.Email,
                birthDay = fm.BirthDay,
                birthMonth = fm.BirthMonth,
                birthYear = fm.BirthYear,
                joinedAt = fm.JoinedAt.Year > 1 ? fm.JoinedAt.ToString("yyyy-MM-dd") : "",
                hasErrors,
                errors
            });
        }
        var initialAdminFamilyRowsJson = System.Text.Json.JsonSerializer.Serialize(initialAdminFamilyRows);
    }
    <partial name="_FamilyMembersEditor" model='new FamilyMembersEditorViewModel(
        ShowJoinedAt: true,
        IntroText: "Fügen Sie weitere Familienmitglieder hinzu. Das Hauptmitglied ist automatisch Teil dieser Familie.",
        InitialRowsJson: initialAdminFamilyRowsJson,
        ShowHrBefore: true)' />

    @* Address fields *@
    <partial name="_AddressFields" model='new AddressFieldsViewModel(
        Model.Member.Street,
        Model.Member.ZipCode,
        Model.Member.City,
        Model.Member.Country,
        ShowHeading: false)' />
    <div class="col-md-6">
        <label asp-for="Member.Notes" class="form-label"></label>
        <textarea asp-for="Member.Notes" class="form-control" rows="3"></textarea>
    </div>
    <div class="col-md-6">
        <label asp-for="Member.BankIban" class="form-label"></label>
        <input asp-for="Member.BankIban" class="form-control" />
    </div>
    <div class="col-md-6">
        <label asp-for="Member.BankBic" class="form-label"></label>
        <input asp-for="Member.BankBic" class="form-control" />
    </div>
    <div class="col-12">
        <button type="submit" class="btn btn-primary">Anlegen</button>
        <a asp-page="Index" class="btn btn-secondary">Abbrechen</a>
    </div>
</form>

@section script {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/_content/VereinMember/js/membership-forms.js" asp-append-version="true"></script>
}