@using Microsoft.AspNetCore.Identity
@using System.Security.Claims
@using VereinMember.Models
@inject SignInManager<MembershipUser> SignInManager
@inject UserManager<MembershipUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
    var user = await UserManager.GetUserAsync(User);
    var displayName = new[]
    {
        user?.UserName,
        user?.Email,
        User.Identity?.Name,
        User.FindFirstValue(ClaimTypes.Email)
    }.FirstOrDefault(v => !string.IsNullOrWhiteSpace(v));
    <div class="d-flex justify-content-between align-items-center mb-3 p-2 bg-light border rounded">
        <div>
            <span class="text-muted small">Angemeldet als</span>
            <strong class="ms-1">@displayName</strong>
        </div>
        <div>
            @if (!string.Equals(ViewContext.RouteData.Values["page"] as string, "/Profile", StringComparison.OrdinalIgnoreCase))
            {
                <a asp-page="/Profile" class="btn btn-sm btn-outline-primary me-1">Profil</a>
            }
            <a asp-page="/Logout" class="btn btn-sm btn-outline-danger">Abmelden</a>
        </div>
    </div>
}