@model DateSelectsViewModel
@{
    var idPrefix = Model.IdPrefix;
}
<div class="row g-1">
    <div class="col-4">
        <select name="@(Model.Prefix)Day" id="@(idPrefix != null ? $"{idPrefix}Day" : null)" class="@Model.SelectCssClass">
            <option value="">Tag</option>
            @for (int d = 1; d <= 31; d++)
            {
                <option value="@d" selected="@(Model.Day == d ? "selected" : null)">@d</option>
            }
        </select>
    </div>
    <div class="col-4">
        <select name="@(Model.Prefix)Month" id="@(idPrefix != null ? $"{idPrefix}Month" : null)" class="@Model.SelectCssClass">
            <option value="">Monat</option>
            @for (int m = 1; m <= 12; m++)
            {
                <option value="@m" selected="@(Model.Month == m ? "selected" : null)">@m</option>
            }
        </select>
    </div>
    <div class="col-4">
        <select name="@(Model.Prefix)Year" id="@(idPrefix != null ? $"{idPrefix}Year" : null)" class="@Model.SelectCssClass">
            <option value="">Jahr</option>
            @for (int y = DateTime.Today.Year; y >= 1900; y--)
            {
                <option value="@y" selected="@(Model.Year == y ? "selected" : null)">@y</option>
            }
        </select>
    </div>
</div>
